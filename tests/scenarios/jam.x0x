# Sends across all five parts: an acid jam built from the panel, 8 bars.
wait 300
# 909: kick on the quarters, closed hat on the off-beats, clap on 2 and 4
tapkey b0
tapkey w0
tapkey w4
tapkey w8
tapkey w12
tapkey b7
tapkey w2
tapkey w6
tapkey w10
tapkey w14
tapkey b6
tapkey w4
tapkey w12
# 303: a TB-3PO line
turn ALGO 2
tap ARP
tap OCT+
# M808: a short bass line
turn ALGO 1
tap SEQ
tapkey w0
tapkey w4
tapkey w8
tapkey w12
# BLIP: every step on, a little more bright
turn ALGO 1
expect part 4
tap SEQ
tapkey w0
tapkey w1
tapkey w2
tapkey w3
tapkey w4
tapkey w5
tapkey w6
tapkey w7
tapkey w8
tapkey w9
tapkey w10
tapkey w11
tapkey w12
tapkey w13
tapkey w14
tapkey w15
tap EDIT
turn K3 20
shot 20_blip_steps.png
# sends: MIX's PARTS, a part picked with its black key: knob 3 its reverb, knob 4 its delay
tap LFO
tapkey b0
turn K3 25
tapkey b2
turn K4 -10
tapkey b3
turn K4 30
shot 21_sends_303.png
tapkey b4
turn K3 30
shot 22_sends_blip.png
# the delay's TAPE (FX, the DELAY page, knob 4): tape already (the factory's), a touch more worn
tap FX
tap FX
turn K4 1
shot 22b_tape.png
expect sound5.2.2 70
expect sound5.4.1 55
# tempo 135, play 8 bars
press HOME
turn SELECT 10
release HOME
expect tempo 135
wav jam.wav
tap PLAY
wait 14300
tap HOME
wait 200
shot 23_home_jam.png
tap PLAY
wait 1500
wavstop
expect peak_db_min -30
